{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 52428800
  },
  "output": {
    "filePath": "repomix-output.json",
    "style": "json",
    "filePathStyle": "target-relative",
    "parsableStyle": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 10,
    "showLineNumbers": false,
    "truncateBase64": true,
    "copyToClipboard": false,
    "includeFullDirectoryStructure": true,
    "tokenCountTree": true,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "src/**/*.go",
    "tests/**/*.go",
    "tools/**/*.go",
    "openspec/**/*.md",
    "docs/**/*.md",
    "conf/**/*",
    "hooks/**/*",
    "pentest/**/*.py",
    "pentest/**/*.sh",
    ".github/scripts/*.py",
    ".github/workflows/*.yml",
    "Makefile",
    "go.mod",
    "go.sum",
    "go.work",
    "go.work.sum",
    "Dockerfile",
    "docker-compose*.yml",
    "repomix.config.json",
    ".repomixignore",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "vendor/**",
      "**/*.test",
      "**/*.out",
      "**/*.prof",
      "*.exe",
      "*.dll",
      "*.so",
      "*.dylib",
      "momo",
      "src/momo",
      "src/src",
      "body*.txt",
      "**/__pycache__/",
      ".github/scripts/__pycache__/",
      "pentest/server-logs/",
      "pentest/fuzzing-reports/",
      "pentest-results/",
      "repomix-output.*",
      "*.repomix.*",
      "node_modules/",
      "package-lock.json",
      "package.json",
      "mempalace.yaml",
      "entities.json",
      ".cortexkit/",
      "skills-lock.json",
      "**/skills-lock.json",
      ".kiro/",
      "**/.kiro/",
      "plan.md",
      "**/plan.md",
      "docs/html/",
      "received_files/",
      "test_data/",
      "*.swp",
      "venv/",
      "**/bin",
      "conf/smoke.conf",
      "test.sh",
      "*_filtered.txt",
      "*_bench*.txt",
      "empty.txt",
      ".gemini/",
      ".jules/",
      ".agents/"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}